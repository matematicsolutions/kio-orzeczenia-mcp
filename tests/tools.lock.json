        "description": "Pobiera pelne orzeczenie KIO.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "signature_or_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ],
              "description": "\"KIO 2924/21\" (string) albo 15903 (internal int ID).\n             Sygnatura wymaga +1 req aby ustalic internal_id przez search."
            }
          },
          "required": [
            "signature_or_id"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "kio_get_orzeczenie",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "9bf0ab9211ed43af579519c0dc4ebd479211cd6597e3855acd38de33ed4dab8a"
    },
