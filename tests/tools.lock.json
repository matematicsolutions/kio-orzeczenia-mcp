    "kio_recent": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Najnowsze orzeczenia KIO z ostatnich N dni.\n\nUWAGA: UZP publikuje orzeczenia z opoznieniem - dla `days=30` lista bywa krotka\nlub pusta, i to jest poprawny wynik, a nie blad parsera. Przy pustym wyniku\nzaproponuj uzytkownikowi szerszy zakres (`days=90`).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "days": {
              "default": 30,
              "description": "ile dni wstecz (default 30, max 3650)",
              "type": "integer"
            },
            "limit": {
              "default": 20,
              "description": "ile orzeczen zwrocic (default 20, max 100)",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "kio_recent",
        "outputSchema": {
          "properties": {
            "result": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "result"
          ],
          "type": "object",
          "x-fastmcp-wrap-result": true
        }
      },
      "sha256": "c1c4192abd9e8b39bec5c18f9e5102cd735461e305bc27735de3083fb55815e5"
    },
    "kio_search": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Wyszukuje orzeczenia KIO w bazie orzeczenia.uzp.gov.pl.\n\nWszystkie parametry opcjonalne. `pzp_article` i `subject_index` to filtry\nserver-side UZP (od 2026-07 wyszukiwarka je udostepnia).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "content_search": {
              "default": true,
              "description": "szukaj w pelnej tresci (default True)",
              "type": "boolean"
            },
            "date_from": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "YYYY-MM-DD"
            },
            "date_to": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "YYYY-MM-DD"
            },
            "inflection": {
              "default": true,
              "description": "odmiana slow (default True)",
              "type": "boolean"
            },
            "page": {
              "default": 1,
              "description": "strona wynikow (default 1)",
              "type": "integer"
            },
            "phrase": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "slowa kluczowe (np \"razaco niska cena\")"
            },
            "pzp_article": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "artykul PZP, format slownika UZP (np \"art. 226 ust. 1 pkt 5\")"
            },
            "signature": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "sygnatura \"KIO {nr}/{rok}\""
            },
            "size": {
              "default": 20,
              "description": "rozmiar strony (default 20, max 100)",
              "type": "integer"
            },
            "sort": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "\"rank\" (trafnosc) | \"date_asc\" | \"date_desc\""
            },
            "subject_index": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "indeks tematyczny (np \"razaco niska cena\")"
            }
          },
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "kio_search",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "5d159c29a0e5c8f8c7c1c6fdc65695fa8101e3fac882f7da20dcf8eb259fdc2c"
    }
  },
