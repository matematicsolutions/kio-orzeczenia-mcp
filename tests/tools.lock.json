{
  "package_version": "0.4.4",
  "tools": {
    "kio_by_pzp_article": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Orzeczenia KIO cytujace konkretny artykul PZP.\n\nUzywa filtra server-side UZP (`Art`), ktory dziala na slowniku przepisow i jest\nwrazliwy na format: `\"art. 226 ust. 1 pkt 5\"` daje trafienia, samo `\"226\"` nie.\nGdy filtr zwroci 0 wynikow, tool schodzi do wyszukiwania frazowego po tresci -\nwtedy trafienia sa szersze i wymagaja weryfikacji przez `kio_get_orzeczenie`.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "article": {
              "description": "np \"art. 226 ust. 1 pkt 5\" albo \"224 ust. 1\"",
              "type": "string"
            },
            "limit": {
              "default": 20,
              "description": "limit wynikow (default 20, max 100)",
              "type": "integer"
            }
          },
          "required": [
            "article"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "kio_by_pzp_article",
        "outputSchema": {
          "properties": {
            "result": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "result"
          ],
          "type": "object",
          "x-fastmcp-wrap-result": true
        }
      },
      "sha256": "cb562e2924664adf4e7aaa458460345654074a99ba60f409461e621b4f5ba9f5"
    },
    "kio_coverage": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Declare what this connector covers, how it is sourced, and what it does NOT cover.\n\nCall this before telling a user that the law \"does not contain\" something, and whenever\na search comes back empty: the absence may be a gap in this connector rather than in the\nlaw. Every gap carries a fallback saying where to look instead.\n\nReturns:\n    ``Coverage`` with families, an as-of note, and a non-empty list of known gaps.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "kio_coverage",
        "outputSchema": {
          "additionalProperties": true,
          "description": "What this connector covers, how it is sourced, and what it does not cover.",
          "properties": {
            "as_of_note": {
              "description": "States what the dates mean, and what they do not promise.",
              "type": "string"
            },
            "families": {
              "items": {
                "additionalProperties": true,
                "description": "One data family this connector exposes.",
                "properties": {
                  "captured_at": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Date this family was last captured (ISO). None when queried live."
                  },
                  "live": {
                    "default": true,
                    "description": "True when queried live instead of from a snapshot.",
                    "type": "boolean"
                  },
                  "name": {
                    "description": "Data family, e.g. 'Federal legislation'.",
                    "type": "string"
                  },
                  "source": {
                    "description": "Official source the data comes from.",
                    "type": "string"
                  },
                  "tool": {
                    "description": "Tool or tools that reach this family.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "tool",
                  "source"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "known_gaps": {
              "description": "Never empty. An empty list would mean 'not checked', not 'no gaps'.",
              "items": {
                "additionalProperties": true,
                "description": "A known, named hole in this connector's coverage - plus the way around it.",
                "properties": {
                  "fallback": {
                    "description": "Where to go instead.",
                    "type": "string"
                  },
                  "family": {
                    "description": "Which family the gap belongs to.",
                    "type": "string"
                  },
                  "id": {
                    "description": "Stable gap identifier.",
                    "type": "string"
                  },
                  "missing": {
                    "description": "What is NOT available through this connector.",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "family",
                  "missing",
                  "fallback"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "status": {
              "default": "ok",
              "enum": [
                "ok",
                "degraded",
                "failed"
              ],
              "type": "string"
            }
          },
          "required": [
            "as_of_note"
          ],
          "type": "object"
        }
      },
      "sha256": "84b48be709d69572d967828fd3b8aedcf53939e71262be737da5aed876207716"
    },
